# PC de oficina con OpenClaw admin y empleado ejecutandose por Docker en la misma maquina.
# El bot corre tambien por Docker y accede al host por host.docker.internal.

TELEGRAM_BOT_TOKEN=REEMPLAZAR_CON_TOKEN_NUEVO_DE_BOTFATHER
TELEGRAM_ALLOWED_USER_IDS=REEMPLAZAR_CON_TU_TELEGRAM_USER_ID
TELEGRAM_ALLOWED_USERNAMES=
OPENCLAW_MODE=gateway
OPENCLAW_REQUEST_TIMEOUT_SECONDS=45
SYNC_TELEGRAM_COMMANDS=true
OPENCLAW_DEFAULT_WORKSPACE=empleado

OPENCLAW_ADMIN_BASE_URL=http://host.docker.internal:18789
OPENCLAW_ADMIN_GATEWAY_TOKEN=PEGAR_AQUI_EL_TOKEN_DE_docker/admin/.env
OPENCLAW_ADMIN_AGENT_ID=main

OPENCLAW_EMPLEADO_BASE_URL=http://host.docker.internal:18790
OPENCLAW_EMPLEADO_GATEWAY_TOKEN=PEGAR_AQUI_EL_TOKEN_DE_docker/empleado/.env
OPENCLAW_EMPLEADO_AGENT_ID=main

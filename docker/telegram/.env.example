TELEGRAM_BOT_TOKEN=replace_me
# En producción: IDs numéricos separados por coma. Vacío = sin filtro por user_id (solo si tampoco hay usernames).
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_USERNAMES=
OPENCLAW_MODE=gateway
OPENCLAW_REQUEST_TIMEOUT_SECONDS=600
SYNC_TELEGRAM_COMMANDS=true
OPENCLAW_DEFAULT_WORKSPACE=empleado

OPENCLAW_ADMIN_BASE_URL=http://host.docker.internal:18789
OPENCLAW_ADMIN_GATEWAY_TOKEN=replace_admin_gateway_token
OPENCLAW_ADMIN_AGENT_ID=main

OPENCLAW_EMPLEADO_BASE_URL=http://host.docker.internal:18790
OPENCLAW_EMPLEADO_GATEWAY_TOKEN=replace_empleado_gateway_token
OPENCLAW_EMPLEADO_AGENT_ID=main

# Contraseñas de perfil (cambiar en producción)
TELEGRAM_ADMIN_PASSWORD=Admin1234*
TELEGRAM_EMPLEADO_PASSWORD=Empleado1234*

# Anti fuerza bruta (contraseña de perfil)
TELEGRAM_AUTH_MAX_ATTEMPTS=5
TELEGRAM_AUTH_LOCKOUT_SECONDS=900

# Métricas LLM → Prometheus (opcional; stack docker/monitoring)
LLM_METRICS_EXPORTER_URL=http://host.docker.internal:9092/v1/record

# Raíz del home del host (debe coincidir con el volumen montado en docker-compose)
TELEGRAM_HOST_HOME=/home/joaquin
# JSONL de pruebas LLM (admin); mismo archivo que monta el panel del stack docker/admin
TELEGRAM_ADMIN_LLM_TEST_LOG_PATH=/data/llm-test-runs.jsonl
# Opcional: sobrescribir política YAML (rutas absolutas, separadas por coma)
# TELEGRAM_ADMIN_READ_ROOTS=...
# TELEGRAM_ADMIN_WRITE_ROOTS=...
# TELEGRAM_ADMIN_DENY_ROOTS=...
# TELEGRAM_EMPLEADO_READ_ROOTS=...
# TELEGRAM_EMPLEADO_WRITE_ROOTS=...
# TELEGRAM_EMPLEADO_DENY_ROOTS=...

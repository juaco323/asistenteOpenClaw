OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.5.7
OPENCLAW_CONTAINER_NAME=openclaw-empleado
OPENCLAW_HOST_PORT=18790
OPENCLAW_INTERNAL_PORT=18789
# Panel histórico pruebas LLM (JSONL en workspace-empleado). Evita choque con admin (18794) y gateway empleado (18790).
LLM_TEST_PANEL_HOST_PORT=18795
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME
OPENCLAW_STATE_DIR=/home/joaquin/.openclaw-empleado
OPENCLAW_HOST_HOME=/home/joaquin
# El workspace del agente se monta desde el repo: workspace-empleado/ (ver docker-compose.yml).

# OpenAI: obligatoria para el chat si usas openai/gpt-5.4 (ver docker/empleado/openclaw.json).
OPENAI_API_KEY=
OPENCLAW_AGENTS_DEFAULTS_MODEL_PRIMARY=openai/gpt-5.4

# GOG (Gmail / Google OAuth en contenedor). No subas .env al git.
# Contraseña del llavero (file); debe ser la misma que en el host al usar GOG_KEYRING_BACKEND=file.
GOG_KEYRING_PASSWORD=
# Remitente Gmail del proyecto (admin y empleado); siempre prueba.openclaw.fj@gmail.com salvo excepción acordada.
GOG_ACCOUNT=prueba.openclaw.fj@gmail.com

OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.5.7
OPENCLAW_CONTAINER_NAME=openclaw-empleado
OPENCLAW_HOST_PORT=18790
OPENCLAW_INTERNAL_PORT=18789
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME
OPENCLAW_STATE_DIR=/home/ubuntu/.openclaw-empleado
OPENCLAW_WORKSPACE_DIR=/home/ubuntu/.openclaw-empleado/workspace

# OpenAI (opcional: copia a .env y rellena; no subas .env al git)
OPENAI_API_KEY=
OPENCLAW_AGENTS_DEFAULTS_MODEL_PRIMARY=openai/gpt-5.4

OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.4.9
OPENCLAW_CONTAINER_NAME=openclaw-admin
OPENCLAW_HOST_PORT=18789
OPENCLAW_INTERNAL_PORT=18789
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME
OPENCLAW_STATE_DIR=/home/ubuntu/.openclaw-admin
OPENCLAW_WORKSPACE_DIR=/home/ubuntu/.openclaw-admin/workspace

# OpenAI (opcional: copia a .env y rellena; no subas .env al git)
OPENAI_API_KEY=
OPENCLAW_AGENTS_DEFAULTS_MODEL_PRIMARY=openai/gpt-4.1-nano

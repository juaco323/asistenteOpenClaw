OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.5.7
OPENCLAW_CONTAINER_NAME=openclaw-admin
OPENCLAW_HOST_PORT=18789
OPENCLAW_INTERNAL_PORT=18789
# Panel histórico pruebas LLM (JSONL). Usa un puerto libre; 18793 suele estar ocupado por openclaw-empleado.
LLM_TEST_PANEL_HOST_PORT=18794
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME
# Debe existir en disco; sustituye por tu home real (ej. echo $HOME → /home/joaquin).
OPENCLAW_STATE_DIR=/home/joaquin/.openclaw-admin
# Home del host: Documentos, Descargas, etc.
OPENCLAW_HOST_HOME=/home/joaquin
# El workspace del agente se monta desde el repo: workspace-admin/ (ver docker-compose.yml).

# OpenAI: obligatoria para que el chat funcione con openai/gpt-5.4 (ver docker/admin/openclaw.json).
OPENAI_API_KEY=
OPENCLAW_AGENTS_DEFAULTS_MODEL_PRIMARY=openai/gpt-5.4

GOG_KEYRING_PASSWORD=
# Remitente Gmail del proyecto (misma cuenta que empleado): prueba.openclaw.fj@gmail.com
GOG_ACCOUNT=prueba.openclaw.fj@gmail.com

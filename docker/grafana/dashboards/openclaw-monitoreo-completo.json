{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Host Ubuntu — CPU y RAM (inactividad vs carga activa)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 85 }] } },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "CPU host (actual)",
      "type": "stat",
      "targets": [{ "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] } },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "RAM host usada (%)",
      "type": "stat",
      "targets": [{ "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "decgbytes" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "RAM host usada (GiB)",
      "type": "stat",
      "targets": [{ "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes)", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2 }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Load average (1m)",
      "type": "stat",
      "targets": [{ "expr": "node_load1", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "drawStyle": "line", "fillOpacity": 20 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "title": "CPU host Ubuntu (%) — serie temporal",
      "type": "timeseries",
      "targets": [
        { "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)", "legendFormat": "CPU uso", "refId": "A" },
        { "expr": "avg(rate(node_cpu_seconds_total{mode=\"iowait\"}[2m])) * 100", "legendFormat": "iowait", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 6,
      "title": "RAM host Ubuntu — serie temporal",
      "type": "timeseries",
      "targets": [
        { "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "RAM usada", "refId": "A" },
        { "expr": "node_memory_MemAvailable_bytes", "legendFormat": "RAM disponible", "refId": "B" },
        { "expr": "node_memory_Cached_bytes + node_memory_Buffers_bytes", "legendFormat": "Cache+buffers", "refId": "C" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "title": "Contenedores Docker OpenClaw (cAdvisor)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 7,
      "title": "CPU por contenedor (%)",
      "type": "timeseries",
      "targets": [{
        "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{image!=\"\", name=~\".*(openclaw|telegram).*\"}[2m])) * 100",
        "legendFormat": "{{name}}",
        "refId": "A"
      }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 8,
      "title": "RAM por contenedor (working set)",
      "type": "timeseries",
      "targets": [{
        "expr": "container_memory_working_set_bytes{image!=\"\", name=~\".*(openclaw|telegram).*\"}",
        "legendFormat": "{{name}}",
        "refId": "A"
      }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 102,
      "title": "LLM GPT-5.4 (cloud) — resumen",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 23 },
      "id": 9,
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Peticiones LLM (última 1h)",
      "type": "stat",
      "targets": [{ "expr": "sum(increase(openclaw_llm_requests_total[1h]))", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 23 },
      "id": 10,
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["mean"] } },
      "title": "Latencia media (1h)",
      "type": "stat",
      "targets": [{
        "expr": "sum(rate(openclaw_llm_request_latency_seconds_sum[1h])) / sum(rate(openclaw_llm_request_latency_seconds_count[1h]))",
        "refId": "A"
      }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 23 },
      "id": 11,
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Latencia p95 (5m)",
      "type": "stat",
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(openclaw_llm_request_latency_seconds_bucket[5m])) by (le))",
        "refId": "A"
      }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 23 },
      "id": 12,
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Tokens totales (última 1h)",
      "type": "stat",
      "targets": [{ "expr": "sum(increase(openclaw_llm_tokens_total[1h]))", "refId": "A" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "title": "Latencia de respuesta API GPT-5.4 (gateway OpenClaw)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "id": 13,
      "title": "Latencia p50 / p95 / media por workspace",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(openclaw_llm_request_latency_seconds_bucket[5m])) by (le, workspace))", "legendFormat": "{{workspace}} p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(openclaw_llm_request_latency_seconds_bucket[5m])) by (le, workspace))", "legendFormat": "{{workspace}} p95", "refId": "B" },
        { "expr": "sum(rate(openclaw_llm_request_latency_seconds_sum[5m])) by (workspace) / sum(rate(openclaw_llm_request_latency_seconds_count[5m])) by (workspace)", "legendFormat": "{{workspace}} media", "refId": "C" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "id": 104,
      "title": "Consumo de tokens GPT-5.4",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 },
      "id": 14,
      "title": "Tasa de tokens / min (prompt vs completion)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(openclaw_llm_tokens_total{token_type=\"prompt\"}[5m])) by (workspace) * 60", "legendFormat": "{{workspace}} prompt/min", "refId": "A" },
        { "expr": "sum(rate(openclaw_llm_tokens_total{token_type=\"completion\"}[5m])) by (workspace) * 60", "legendFormat": "{{workspace}} completion/min", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 37 },
      "id": 15,
      "title": "Tokens acumulados por workspace y tipo",
      "type": "timeseries",
      "targets": [{
        "expr": "sum(increase(openclaw_llm_tokens_total[1h])) by (workspace, token_type)",
        "legendFormat": "{{workspace}} {{token_type}}",
        "refId": "A"
      }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 },
      "id": 105,
      "title": "Peticiones LLM — éxito vs error",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 46 },
      "id": 16,
      "title": "Tasa de peticiones por workspace y origen",
      "type": "timeseries",
      "targets": [{
        "expr": "sum(rate(openclaw_llm_requests_total[5m])) by (workspace, source)",
        "legendFormat": "{{workspace}} / {{source}}",
        "refId": "A"
      }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 46 },
      "id": 17,
      "title": "Peticiones OK vs error",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(openclaw_llm_requests_total{status=\"ok\"}[5m]))", "legendFormat": "ok", "refId": "A" },
        { "expr": "sum(rate(openclaw_llm_requests_total{status=\"error\"}[5m]))", "legendFormat": "error", "refId": "B" }
      ]
    }
  ],

# Secrets and local runtime (nunca commitear valores reales)
.env
.env.*
**/.env
**/.env.*
.env.local
!.env.example
!**/.env.example
!**/.env.pc-oficina.example

# Credenciales Docker OpenClaw (valores reales; nunca versionar)
docker/admin/.env
docker/empleado/.env
docker/telegram/.env

# Bandeja local de credenciales (admin.env, .docx, etc.)
credentials-inbox/*
!credentials-inbox/README.md

# Otros .env con nombre de perfil (p. ej. admin.env en Documentos)
**/admin.env
**/empleado.env
**/telegram.env

# Credenciales consolidadas (solo copia local; nunca versionar)
CREDENCIALES-USO-PRIVADO.md
*.local

# OAuth / Gmail (gog) y llaveros — solo en el host (~/.config/gogcli)
**/gogcli/
**/client_secret*.json
**/client_secret.json
**/token.json
**/credentials.json
openclaw-gog-keyring.pw
**/auth-profiles.json

# OpenClaw runtime/state that should not be versioned
.openclaw/
credentials/
media/
cron/runs/
*.jsonl

# Bot Telegram: auditoría y estado local (puede contener rutas/IDs de usuario)
integrations/telegram-bot/data/*
!integrations/telegram-bot/data/.gitkeep

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
docker/admin/llm-test-logger/.venv/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
